---
/*
 * A rice's hero loop with hour chips that light up in step with the
 * footage. Both loops are recorded by the rice's capture.sh on the same
 * schedule (17.1 s): each chip switches at the midpoint of the on-screen
 * cross-fade.
 */
import afterglowPoster from '@afterglow/hero.jpg';
import afterglowWebm from '@afterglow/hero.webm?url';
import afterglowMp4 from '@afterglow/hero.mp4?url';
import horizonPoster from '@horizon/hero.jpg';
import horizonWebm from '@horizon/hero.webm?url';
import horizonMp4 from '@horizon/hero.mp4?url';

interface Props {
  rice?: 'horizon' | 'afterglow';
  controls?: boolean;
  tag?: string;
}

const loops = {
  horizon: {
    poster: horizonPoster,
    webm: horizonWebm,
    mp4: horizonMp4,
    label: 'Horizon: the time written across a procedural sky above the sea, a notification arriving and a frosted control center turned in 3D, while the sky drifts from golden hour through afterglow and blue hour to night'
  },
  afterglow: {
    poster: afterglowPoster,
    webm: afterglowWebm,
    mp4: afterglowMp4,
    label: 'Afterglow: live terminal windows float above a procedural sea while the sky drifts from golden hour through afterglow and blue hour to night'
  }
};

const { rice = 'horizon', controls = false, tag = 'Live Wayland surfaces · GLES2 · one C plugin' } = Astro.props;
const loop = loops[rice];

const hours = [
  { id: 'golden', label: 'Golden hour' },
  { id: 'afterglow', label: 'Afterglow' },
  { id: 'blue', label: 'Blue hour' },
  { id: 'night', label: 'Night' }
];
---
<figure class="hour-frame" data-hour-video>
  <video
    autoplay
    muted
    loop
    playsinline
    controls={controls}
    preload="metadata"
    width="1280"
    height="720"
    poster={loop.poster.src}
    aria-label={loop.label}
  >
    <source src={loop.webm} type="video/webm" />
    <source src={loop.mp4} type="video/mp4" />
  </video>
  <figcaption class="hour-bar">
    <ul class="hours" aria-label="Times of day in the loop">
      {hours.map((hour, i) => (
        <li data-hour={hour.id} class={i === 0 ? 'is-active' : undefined}>{hour.label}</li>
      ))}
    </ul>
    <span class="hour-tag">{tag}</span>
  </figcaption>
</figure>

<script>
  // Seconds into the loop at which each hour becomes the current one.
  const marks: Array<[number, string]> = [
    [0, 'golden'],
    [2.3, 'afterglow'],
    [6.0, 'blue'],
    [10.2, 'night'],
    [14.3, 'golden']
  ];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const frame of document.querySelectorAll<HTMLElement>('[data-hour-video]')) {
    const video = frame.querySelector('video');
    const chips = frame.querySelectorAll<HTMLElement>('.hours li');
    if (!video) continue;

    // Respect reduced motion: show the poster frame instead of autoplaying.
    if (reduce.matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }

    let current = '';
    const sync = () => {
      const t = video.currentTime;
      let hour = 'golden';
      for (const [at, id] of marks) if (t >= at) hour = id;
      if (hour !== current) {
        current = hour;
        chips.forEach((chip) => chip.classList.toggle('is-active', chip.dataset.hour === hour));
      }
      if (!video.paused) requestAnimationFrame(sync);
    };
    video.addEventListener('play', () => requestAnimationFrame(sync));
    video.addEventListener('seeked', sync);
    if (!video.paused) requestAnimationFrame(sync);
  }
</script>
